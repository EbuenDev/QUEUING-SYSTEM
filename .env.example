# =================================================================
# RHU II Patient Queuing System - Environment Configuration Template
# Copy this file to .env and adjust values for your environment:
#   copy .env.example .env (Windows)
#   cp .env.example .env   (Linux/macOS)
# =================================================================

# -----------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------
# DB_HOST:
#   - For Docker deployment: postgres (matches service name in docker-compose)
#   - For Local / Laragon / XAMPP / direct Windows: localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rhu_queue_system
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# -----------------------------------------------------------------
# Application & Web Server Configuration
# -----------------------------------------------------------------
# Port exposed on host machine when running Docker (default: 8081)
APP_PORT=8081

# Timezone (Philippine Standard Time)
TZ=Asia/Manila

# -----------------------------------------------------------------
# CORS Configuration (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------
# Set to * to allow all clients on the local network (LAN)
# Or specify comma-separated list of origins (e.g. http://localhost:8081,http://192.168.1.100:8081)
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------
# Default Application Credentials (Offline / Fallback Auth)
# Note: User accounts are also managed in the database `users` table.
# -----------------------------------------------------------------
# Super Administrator (Full system and user management access)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin123

# System Administrator (Queue management, TV player, patient check-in)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
LEGACY_ADMIN_PASSWORD=admin123

# Doctor Account (Consultation panel, calling patients, prescriptions)
DOCTOR_USERNAME=renz
DOCTOR_PASSWORD=renzsale
